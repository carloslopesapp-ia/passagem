      "versionNonce": 369408382,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785221822265,
      "link": null,
      "locked": false,
      "text": "Os nomes mais fortes tendem a ser curtos, fáceis de pronunciar, emocionalmente\npositivos e suficientemente amplos para acompanhar a evolução do produto.\n\"Wellora\" cumpre estes critérios:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Os nomes mais fortes tendem a ser curtos, fáceis de pronunciar, emocionalmente positivos e suficientemente amplos para acompanhar a evolução do produto. \"Wellora\" cumpre estes critérios:",
      "autoResize": false,
      "lineHeight": 1.25
    },
