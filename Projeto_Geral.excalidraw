      "isDeleted": false,
      "boundElements": [],
      "updated": 1785221822265,
      "link": null,
      "locked": false,
      "text": "Porque considero \"Wellora\" uma boa escolha",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Porque considero \"Wellora\" uma boa escolha",
